    "\n",
    "plt.plot(df[\"x\"], df[\"y\"], \"o-\", label=\"带噪声的 sin\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.title(\"从 CSV 读回的数据可视化\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
