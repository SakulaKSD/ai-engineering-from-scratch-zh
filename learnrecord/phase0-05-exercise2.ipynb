   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "x = np.linspace(0, 10, 50)                       # 0~10 取 50 个点\n",
    "y = np.sin(x) + np.random.randn(50) * 0.1        # 正弦 + 一点随机噪声\n",
    "\n",
    "df = pd.DataFrame({\"x\": x, \"y\": y})              # 组装成一张表（DataFrame）\n",
    "df.to_csv(\"data.csv\", index=False)               # 存成 CSV 文件（存在当前目录）\n",
    "\n",
    "df.head()                                        # 显示前 5 行，确认长啥样"
   ]
  },
